# =============================================================
# DocuFlow AI — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# ---- Application ----
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-secret-key
APP_NAME=DocuFlow AI
APP_VERSION=1.0.0
FRONTEND_URL=http://localhost:5175

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://docuflow:docuflow_pass@localhost:5432/docuflow_db
SYNC_DATABASE_URL=postgresql://docuflow:docuflow_pass@localhost:5432/docuflow_db

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Celery ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- JWT ----
JWT_SECRET=change-this-to-another-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Storage ----
STORAGE_PROVIDER=local
# Options: local | s3
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET=docuflow-files
STORAGE_CDN_URL=

# ---- AWS S3 (for production) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ---- AI Provider ----
AI_PROVIDER=mock
# Options: mock | openai | anthropic | local
AI_API_KEY=
AI_MODEL=gpt-4o-mini

AI_BASE_URL=

# ---- OCR ----
OCR_PROVIDER=tesseract
TESSERACT_CMD=/usr/bin/tesseract

# ---- Speech-to-Text ----
STT_PROVIDER=whisper
WHISPER_MODEL=base
# Options: tiny | base | small | medium | large

# ---- File Size Limits (in bytes) ----
MAX_PDF_SIZE=52428800
MAX_IMAGE_SIZE=20971520
MAX_AUDIO_SIZE=104857600
MAX_VIDEO_SIZE=524288000
MAX_DOC_SIZE=20971520

# ---- CORS ----
CORS_ORIGINS=http://localhost:5175,http://localhost:3000

# ---- Razorpay (Payment) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ---- Email (for notifications) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@docuflowai.com

# ---- Admin ----
FIRST_ADMIN_EMAIL=bharathguguloth735@gmail.com
FIRST_ADMIN_PASSWORD=12345678

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60
